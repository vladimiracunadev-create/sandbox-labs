      "id": "dry-run",
      "label": "Dry run",
      "status": "ready",
      "requires": [],
      "controls": [
        "planning",
        "evidence"
      ]
    },
    {
      "id": "native",
      "label": "Native baseline",
      "status": "experimental",
      "requires": [
        "explicit opt-in"
      ],
      "controls": [
        "timeout",
        "environment",
        "output"
      ]
    },
    {
      "id": "bwrap",
      "label": "bubblewrap rootless",
      "status": "experimental",
