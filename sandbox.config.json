{
  "$schema": "./schemas/catalog.schema.json",
  "project": {
    "name": "Sandbox Labs",
    "version": "0.1.0",
    "controlCenterPort": 9093,
    "defaultRuntime": "dry-run",
    "evidenceDirectory": "evidence/runs",
    "dataDirectory": ".sandbox-data"
