{
  "$schema": "./schemas/catalog.schema.json",
  "project": {
    "name": "Sandbox Labs",
    "version": "0.1.0",
    "controlCenterPort": 9093,
    "defaultRuntime": "dry-run",
    "evidenceDirectory": "evidence/runs",
    "dataDirectory": ".sandbox-data"
  },
  "runtimes": [
    {
      "id": "dry-run",
      "label": "Dry run",
      "status": "ready",
      "requires": [],
      "controls": [
        "planning",
        "evidence"
      ]
    },
    {
      "id": "native",
      "label": "Native baseline",
      "status": "experimental",
      "requires": [
        "explicit opt-in"
      ],
      "controls": [
        "timeout",
        "environment",
        "output"
      ]
    },
    {
      "id": "bwrap",
      "label": "bubblewrap rootless",
      "status": "experimental",
      "requires": [
        "Linux",
        "bwrap"
      ],
      "controls": [
        "filesystem",
        "network",
        "timeout",
        "capabilities",
        "devices",
        "environment",
        "output"
      ]
    },
    {
      "id": "unshare",
      "label": "Linux namespaces",
      "status": "experimental",
      "requires": [
        "Linux",
        "unshare"
      ],
      "controls": [
        "network",
        "timeout",
        "environment",
        "output"
      ]
    },
    {
      "id": "wasi",
      "label": "WebAssembly/WASI",
      "status": "experimental",
      "requires": [
        "wasmtime",
        "WASI module"
      ],
      "controls": [
        "filesystem",
        "network",
        "timeout",
        "environment",
        "output"
      ]
    },
    {
      "id": "gvisor",
      "label": "gVisor runsc",
      "status": "documented",
      "requires": [
        "Linux",
        "runsc",
        "OCI bundle"
      ],
      "controls": [
        "filesystem",
        "network",
        "processes",
        "memory",
        "cpu",
        "timeout",
        "capabilities",
        "syscalls",
        "devices",
        "environment",
        "output"
      ]
    },
    {
      "id": "kata",
      "label": "Kata Containers",
      "status": "manual",
      "requires": [
        "Linux",
        "containerd",
        "Kata runtime"
      ],
      "controls": [
        "filesystem",
        "network",
        "processes",
        "memory",
        "cpu",
        "timeout",
        "capabilities",
        "syscalls",
        "devices",
        "environment",
        "output"
      ]
    },
    {
      "id": "firecracker",
      "label": "Firecracker microVM",
      "status": "manual",
      "requires": [
        "Linux",
        "KVM",
        "firecracker",
        "jailer",
        "kernel",
        "rootfs"
      ],
      "controls": [
        "filesystem",
        "network",
        "processes",
        "memory",
        "cpu",
        "timeout",
        "capabilities",
        "syscalls",
        "devices",
        "environment",
        "output"
      ]
    }
