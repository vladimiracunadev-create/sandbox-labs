{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Labs Service",
  "description": "Servicio de larga duración que se levanta dentro de un sandbox y publica un puerto en el loopback del host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "description", "teaches", "port", "kind", "entrypoint", "command", "args", "policy", "runtimes", "healthPath"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["starter", "containment", "platform"] },
    "description": { "type": "string", "minLength": 1 },
    "teaches": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "kind": { "enum": ["python", "node", "script", "binary"] },
    "entrypoint": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "args": { "type": "array", "items": { "type": "string", "maxLength": 512 } },
    "policy": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "runtimes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "healthPath": { "type": "string", "pattern": "^/" }
  }
}
