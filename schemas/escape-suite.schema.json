{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Labs Escape Suite",
  "description": "Registro de sondas de contención. Cada sonda apunta a una carga registrada y a la dimensión de aislamiento que mide.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "dimensions", "probes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "workload", "control", "argument"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "dimension": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "workload": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "control": {
            "enum": [
              "filesystem",
              "network",
              "processes",
              "memory",
              "cpu",
              "timeout",
              "capabilities",
              "syscalls",
              "devices",
              "environment",
              "output"
            ]
          },
          "argument": {
            "description": "Campo de policy.resources que se pasa como argumento a la sonda, o null.",
            "type": ["string", "null"],
            "enum": ["memoryMb", "processes", "openFiles", "timeoutSeconds", null]
          }
        }
      }
    }
  }
}
