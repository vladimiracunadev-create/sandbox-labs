{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Job Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadId",
    "policyId",
    "runtimeId",
    "arguments"
  ],
  "properties": {
    "workloadId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "arguments": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
