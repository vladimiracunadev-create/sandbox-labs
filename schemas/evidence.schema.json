{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Labs Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "timestamp",
    "status",
    "runtime",
    "host",
    "integrity",
    "policy",
    "workload",
    "limits",
    "result",
    "violations",
    "unsupported",
    "plan"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "timeout"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "available"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policySha256",
        "workloadSha256",
        "runnerVersion"
      ],
      "properties": {
        "policySha256": {
          "type": "string",
          "minLength": 16
        },
        "workloadSha256": {
          "type": "string",
          "minLength": 16
        },
        "runnerSha256": {
          "type": "string",
          "minLength": 1
        },
        "runnerVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSha256": {
          "description": "SHA-256 del propio contenido de la evidencia, calculado con este campo vacío. Detecta alteración accidental; no es una firma.",
          "type": "string"
        },
        "previousEvidenceSha256": {
          "description": "Huella de la evidencia anterior de este directorio. Encadenarlas detecta lo que una firma no ve: que alguien BORRE un informe.",
          "type": "string"
        },
        "signature": {
          "description": "Firma Ed25519 sobre la huella. Detecta que alguien rehiciera el documento recalculando su SHA-256. No es una notarización: la clave la guarda la misma máquina que ejecuta.",
          "type": "object",
          "required": [
            "algorithm",
            "publicKey",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "publicKey": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "signatureUnavailable": {
          "description": "Por qué no se pudo firmar. Una evidencia sin firma que no dice el motivo se confunde con una que nadie quiso firmar.",
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enforcement",
        "requestedControls"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "enforcement": {
          "enum": [
            "strict",
            "best-effort"
          ]
        },
        "requestedControls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "effectiveControls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "unsupportedControls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "risk",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "effective",
        "observed"
      ],
      "properties": {
        "requested": {
          "type": "object"
        },
        "effective": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "observed": {
          "description": "Consumo real leído del cgroup mientras la carga corría. Vacío si no hubo cgroup propio que observar: nunca se rellena con cifras del host.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "reason",
        "durationMs",
        "stdout",
        "stderr",
        "stdoutTruncated",
        "stderrTruncated"
      ],
      "properties": {
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdoutTruncated": {
          "type": "boolean"
        },
        "stderrTruncated": {
          "type": "boolean"
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "operation",
          "target",
          "result"
        ],
        "properties": {
          "control": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "networkEvents": {
      "description": "Cada intento de salida por el canal filtrado, con destino, veredicto y bytes movidos. Vacío cuando la política no monta canal.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "allowed"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "bytesSent": {
            "type": "integer"
          },
          "bytesReceived": {
            "type": "integer"
          }
        }
      }
    },
    "artifacts": {
      "description": "Ficheros que produjo la ejecución, con su hash.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "cleanup": {
      "description": "Qué se retiró al terminar.",
      "type": "object"
    },
    "verdict": {
      "description": "¿Se puede confiar en esta ejecución? No es lo mismo que si terminó bien: perder un control pedido no es un aprobado aunque el código de salida sea 0.",
      "enum": [
        "contained",
        "controls-missing",
        "timeout",
        "failed",
        "not-executed",
        ""
      ]
    }
  }
}
