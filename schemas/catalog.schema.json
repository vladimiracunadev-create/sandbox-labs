{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sandbox Labs Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "casesDirectory",
    "policiesDirectory",
    "project",
    "runtimes",
    "workloadsDirectory"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "controlCenterPort",
        "defaultRuntime",
        "evidenceDirectory",
        "dataDirectory"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "controlCenterPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "defaultRuntime": {
          "type": "string",
          "minLength": 1
        },
        "evidenceDirectory": {
          "type": "string",
          "minLength": 1
        },
        "dataDirectory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status",
          "requires",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ready",
              "experimental",
              "documented",
              "manual",
              "planned"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "workloadsDirectory": {
      "type": "string",
      "minLength": 1
    },
    "policiesDirectory": {
      "type": "string",
      "minLength": 1
    },
    "casesDirectory": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "idea",
          "port",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "idea": {
            "type": "string",
            "minLength": 1,
            "description": "La idea que este caso enseña y ningún otro enseña."
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "status": {
            "enum": [
              "planned",
              "building",
              "ready"
            ]
          }
        }
      }
    },
    "families": {
      "description": "Familias del catálogo. Los sandboxes técnicos y los de dominio regulado NO se mezclan: tienen modelos de amenazas distintos y mezclarlos haría que una advertencia de uno se leyera como si valiera para el otro.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "path",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "technical",
              "capital-markets"
            ]
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
