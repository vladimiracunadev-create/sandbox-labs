{
  "name": "sandbox-labs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dashboard:dev": "pnpm --dir control-center dev",
    "dashboard:start": "pnpm --dir control-center start",
    "dashboard:build": "pnpm --dir control-center build",
    "dashboard:test": "pnpm --dir control-center test",
    "docs:check": "node scripts/check-doc-links.mjs",
    "config:check": "node scripts/validate-config.mjs",
    "manifest": "node scripts/generate-file-manifest.mjs",
    "check": "pnpm config:check && pnpm docs:check && pnpm site:check && pnpm cases:check && pnpm dashboard:test && pnpm evidence:check && pnpm test:cleanup",
    "cases:check": "node scripts/verify-cases.mjs",
    "evidence:check": "node scripts/validate-evidence.mjs",
    "test:cleanup": "node scripts/cleanup-test-state.mjs",
    "cases": "node --run config:check",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/build-site.mjs && node scripts/check-site-links.mjs"
  }
}
