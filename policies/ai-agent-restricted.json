{
  "$schema": "../schemas/policy.schema.json",
  "id": "ai-agent-restricted",
  "description": "Código generado por IA con salida de red restringida a una allowlist: un agente necesita llamar a su API, no a internet entero. AVISO: hoy ningún runtime del proyecto hace cumplir esa lista — no hay proxy de salida ni reglas de firewall— así que el control `network` nunca sale efectivo y esta política, al ser estricta, NO EJECUTA. Está aquí como la frontera que se quiere, no como una que ya exista. Ver B-04 en docs/IMPLEMENTATION_BACKLOG.md.",
  "enforcement": {
    "mode": "strict",
    "requiredControls": [
      "filesystem",
      "network",
      "processes",
      "memory",
      "timeout",
      "capabilities",
      "environment",
      "output"
    ]
  },
  "filesystem": {
    "root": "ephemeral",
    "readOnly": [
      "/workspace/input"
    ],
    "writable": [
      "/workspace/output"
    ],
    "maxWorkspaceMb": 256,
    "followSymlinks": false
  },
  "network": {
    "mode": "allowlist",
    "hosts": [
      "api.anthropic.com"
    ],
    "dns": "system"
  },
  "resources": {
    "cpu": 1,
    "memoryMb": 512,
    "processes": 40,
    "timeoutSeconds": 86400,
    "openFiles": 128,
    "outputBytes": 262144
  },
  "process": {
    "capabilities": [],
    "environment": {
      "LANG": "C.UTF-8",
      "NO_COLOR": "1",
      "PATH": "/usr/local/bin:/usr/bin:/bin",
      "HOME": "/workspace"
    },
    "allowedEnvironment": [
      "SANDBOX_AI_API_KEY",
      "SANDBOX_AI_ENDPOINT",
      "SANDBOX_EGRESS_ALLOWLIST"
    ],
    "user": 65534,
    "group": 65534
  },
  "syscalls": {
    "profile": "default",
    "allow": [],
    "deny": []
  },
  "devices": {
    "allow": [
      "null",
      "zero",
      "random",
      "urandom"
    ]
  }
}
