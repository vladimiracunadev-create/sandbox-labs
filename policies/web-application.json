{
  "$schema": "../schemas/policy.schema.json",
  "id": "web-application",
  "description": "Aplicación web local: conserva la red del host para publicar un puerto y acota filesystem, tiempo y salida. El control `network` no se declara porque aquí no hay ninguno.",
  "enforcement": {
    "mode": "best-effort",
    "requiredControls": [
      "filesystem",
      "timeout",
      "output"
    ]
  },
  "filesystem": {
    "root": "ephemeral",
    "readOnly": [
      "/workspace/app"
    ],
    "writable": [
      "/workspace/tmp"
    ],
    "maxWorkspaceMb": 256,
    "followSymlinks": false
  },
  "network": {
    "mode": "unrestricted",
    "hosts": [],
    "dns": "disabled"
  },
  "resources": {
    "cpu": 1.5,
    "memoryMb": 512,
    "processes": 64,
    "timeoutSeconds": 120,
    "openFiles": 256,
    "outputBytes": 524288
  },
  "process": {
    "capabilities": [],
    "environment": {
      "NODE_ENV": "production"
    },
    "allowedEnvironment": [],
    "user": 65534,
    "group": 65534
  },
  "syscalls": {
    "profile": "default",
    "allow": [],
    "deny": [
      "mount",
      "ptrace"
    ]
  },
  "devices": {
    "allow": [
      "null",
      "zero",
      "random",
      "urandom"
    ]
  }
}
