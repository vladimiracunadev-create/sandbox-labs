{
  "$schema": "../schemas/policy.schema.json",
  "id": "high-risk",
  "description": "Muestras desconocidas; exige runtime fuerte y falla cerrado.",
  "enforcement": {
    "mode": "strict",
    "requiredControls": [
      "filesystem",
      "network",
      "processes",
      "memory",
      "cpu",
      "timeout",
      "capabilities",
      "syscalls",
      "devices",
      "environment",
      "output"
    ]
  },
  "filesystem": {
    "root": "ephemeral",
    "readOnly": [],
    "writable": [
      "/workspace/output"
    ],
    "maxWorkspaceMb": 256,
    "followSymlinks": false
  },
  "network": {
    "mode": "none",
    "hosts": [],
    "dns": "disabled"
  },
  "resources": {
    "cpu": 0.5,
    "memoryMb": 256,
    "processes": 16,
    "timeoutSeconds": 20,
    "openFiles": 32,
    "outputBytes": 65536
  },
  "process": {
    "capabilities": [],
    "environment": {
      "LANG": "C.UTF-8",
      "NO_COLOR": "1"
    },
    "allowedEnvironment": [],
    "user": 65534,
    "group": 65534
  },
  "syscalls": {
    "profile": "strict",
    "allow": [],
    "deny": [
      "mount",
      "ptrace",
      "reboot",
      "kexec_load",
      "bpf",
      "perf_event_open",
      "clone3"
    ]
  },
  "devices": {
    "allow": [
      "null",
      "zero",
      "random",
      "urandom"
    ]
  }
}
